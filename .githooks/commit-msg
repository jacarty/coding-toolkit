#!/bin/sh
#
# Commit-msg hook: Conventional Commits validation.
# https://www.conventionalcommits.org/
#
#   <type>(<optional scope>)<optional !>: <description>
#
# The description starts with a lowercase letter, a digit, or an acronym
# (`fix: 404 handling`, `feat: OAuth login`) and doesn't end with a period.
# A subject over 72 characters is a warning, not an error.
#
# Install with .githooks/setup-hooks.sh. Skip with --no-verify.

set -eu

COMMIT_MSG_FILE=$1
# The subject is the first line that isn't blank or a git comment, as git
# itself strips those.
SUBJECT=$(tr -d '\r' < "$COMMIT_MSG_FILE" | grep -vE '^(#|[[:space:]]*$)' | head -n 1 || true)

# Leave merges, reverts and autosquash commits to git.
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*|"") exit 0 ;;
esac

VALID_TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
PATTERN="^($VALID_TYPES)(\([a-z0-9._-]+\))?!?: ([a-z0-9]|[A-Z][A-Z0-9])(.*[^.])?$"

if ! printf '%s\n' "$SUBJECT" | grep -qE "$PATTERN"; then
    {
        printf '\n✗ Invalid commit message format\n\n'
        printf '  Your message:    %s\n' "$SUBJECT"
        printf '  Expected format: <type>(<scope>): <description>\n\n'
        printf '  Types: %s\n' "$(printf '%s' "$VALID_TYPES" | sed 's/|/, /g')"
        printf '  The description starts with a lowercase letter, digit or acronym,\n'
        printf "  and doesn't end with a period. Add ! before : for a breaking change.\n\n"
        printf '  Examples:\n'
        printf '    feat(auth): add OAuth2 login\n'
        printf '    fix: 404 on a missing user\n'
        printf '    feat(api)!: change the response format\n\n'
        printf '  Skip this check with: git commit --no-verify\n'
    } >&2
    exit 1
fi

# Characters, not bytes (dash's ${#var} counts bytes).
LENGTH=$(printf '%s' "$SUBJECT" | wc -m | tr -d ' ')
if [ "$LENGTH" -gt 72 ]; then
    printf '⚠ Subject is %s characters; 72 or fewer is conventional.\n' "$LENGTH" >&2
fi
exit 0
