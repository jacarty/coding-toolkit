#!/bin/sh
#
# Pre-push hook: check every branch being pushed, not just the checked-out one.
# - Blocks pushing straight to the default branch: changes go through a PR.
# - Checks that each branch is named <type>/<slug>, with a Conventional
#   Commits type and a lowercase, hyphenated slug.
# Deleting a remote branch and pushing tags aren't checked.
#
# Install with .githooks/setup-hooks.sh. A local check that --no-verify can
# skip; the repo's main-protection ruleset enforces the same on GitHub.

set -eu

REMOTE=${1:-origin}   # the remote's name, or its URL for a URL push
VALID_TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
BRANCH_PATTERN="^($VALID_TYPES)/[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$"
# Long-lived branches that are named, not typed (unless one is the default).
LONG_LIVED="main|master|dev|develop|staging|production|release"

# The default branch: ask the remote (we're about to contact it anyway),
# then git's cached copy, then assume main or master.
DEFAULT=$(git ls-remote --symref "$REMOTE" HEAD 2>/dev/null | sed -n 's|^ref: refs/heads/\(.*\)[[:space:]]HEAD$|\1|p' | head -n 1)
if [ -z "$DEFAULT" ]; then
    DEFAULT=$(git symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null || true)
    DEFAULT=${DEFAULT#"$REMOTE"/}
fi

fail=0
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
    : "$local_ref" "$remote_sha"  # read but not needed
    case "$remote_ref" in
        refs/heads/*) branch=${remote_ref#refs/heads/} ;;
        *) continue ;;  # tags and other refs
    esac
    # Deleting a branch (the local sha is all zeros): nothing to check.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac

    if [ "$branch" = "$DEFAULT" ] || { [ -z "$DEFAULT" ] && { [ "$branch" = main ] || [ "$branch" = master ]; }; }; then
        printf '✗ Pushing straight to %s: open a PR from a branch instead.\n' "$branch" >&2
        fail=1
        continue
    fi
    if printf '%s\n' "$branch" | grep -qE "^($LONG_LIVED)$"; then
        continue
    fi
    if ! printf '%s\n' "$branch" | grep -qE "$BRANCH_PATTERN"; then
        printf '✗ Invalid branch name: %s\n' "$branch" >&2
        printf '  Expected <type>/<slug>, e.g. feat/oauth-login or fix/ci\n' >&2
        printf '  Types: %s\n' "$(printf '%s' "$VALID_TYPES" | sed 's/|/, /g')" >&2
        printf '  Slug: lowercase letters, digits and hyphens; starts and ends with a letter or digit; up to 50 characters\n' >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    printf '\nPush blocked. Skip this check with: git push --no-verify\n' >&2
    exit 1
fi
exit 0
